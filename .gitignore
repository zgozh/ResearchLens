# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Env & secrets
.env
.env.local
.env*.local

# Runtime data
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
*.log
# 运行期落盘的解析资产与上传原件（体积大、可再生产；容器内由 backend-data 卷承载）
backend/data/assets/
backend/data/uploads/

# 单测临时目录：conftest 每次会话重建，里面的 PDF/DB 都是跑测试的产物
backend/app/tests/unit/_tmp/
backend/app/tests/unit/_tmp_shared/

# 本地工具状态（备份 tarball 等，非源码）
.workbuddy/

# Local verification artifacts
edge_profile/
edge_p2/
edge_p3/
edge_*/
dom_check.html
dom_*.html

# IDE
.idea/
.vscode/
.DS_Store

# Build
dist/
build/

# 临时验收脚本与探针输出（本地，非源码）
.scratch/

# SQLite WAL/SHM（本地运行态）
*.db-shm
*.db-wal

# 环境文件的所有变体（含备份）：backend/.env 曾被 compose 当作影子配置，
# 且其备份会把真实密钥带进仓库——一律忽略
**/.env
**/.env.*
!**/.env.example
