# ============================================================
# ResearchLens 环境配置示例
# 复制为 .env 后使用：  cp .env.example .env
# ============================================================

# --- 运行模式 ---

# --- ----------- 后端 ----------- ---
# 存储: sqlite=本地开发(零依赖) / postgresql+psycopg=生产(Docker 内)
DATABASE_URL=sqlite:///./data/researchlens.db
# 后端端口（Docker 内固定 8000；本机若被占用可改，如 8001）
BACKEND_PORT=8000

# --- ----------- 前端 ----------- ---
# 前端访问后端的地址（浏览器可达；与 BACKEND_PORT 保持一致）
NEXT_PUBLIC_API_URL=http://localhost:8000
# 前端端口（Docker 内固定 3000；本机被占用可改，如 3001）
FRONTEND_PORT=3000

# --- AI (仅 LIVE 模式需要) ---
# 默认推荐阿里云百炼 DashScope（OpenAI 兼容）：
#   主页 https://bailian.console.aliyun.com/  →  API-KEY 管理
#   兼容端点 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 视觉模型（图表/图片理解；DashScope 用 qwen-vl-max）
VISION_MODEL=qwen-vl-max
# 嵌入模型（RAG 检索；DashScope 兼容模式用 text-embedding-v3）
EMBEDDING_MODEL=text-embedding-v3

# --- 多供应商候选路由（可选，逗号分隔；用于 LLM 治理/降级） ---
# 格式: key1@url1|model1,key2@url2|model2
LLM_FALLBACKS=

# --- 可选: TTS / 外部数字人 API（可在 .env 里填；失败自动降级字幕） ---
TTS_API_KEY=
TTS_BASE_URL=
TTS_VOICE=zh-CN-XiaoxiaoNeural

# --- Cross-origin（允许前端各端口） ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# --- 前端数据源开关（构建期注入，改后需 --build 重建 frontend） ---
# 0（默认）= 走真实 canonical API（§5.12）；1 = 静态 fixtures，仅离线开发用。
NEXT_PUBLIC_USE_FIXTURES=0
