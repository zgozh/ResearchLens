# ============================================================
# ResearchLens 环境配置示例
# 复制为 .env 后使用：  cp .env.example .env
# ============================================================

# --- 运行模式 ---
# DEMO_MODE=true  → 无需任何 API Key 即可完整演示（读内置 seed）
# DEMO_MODE=false → LIVE 模式，调用 LLM / Vision / RAG（需填下方 API）
DEMO_MODE=true

# --- ----------- 后端 ----------- ---
# 存储: sqlite=本地开发(零依赖) / postgresql+psycopg=生产(Docker 内)
DATABASE_URL=sqlite:///./data/researchlens.db
# 后端端口
BACKEND_PORT=8000

# --- ----------- 前端 ----------- ---
# 前端访问后端的地址（浏览器可达）
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# --- AI (仅 LIVE 模式需要) ---
# OpenAI-compatible 接口
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 视觉模型（用于图表/图片理解）
VISION_MODEL=gpt-4o
# 嵌入模型（RAG 检索，需要 embedding 接口）
EMBEDDING_MODEL=text-embedding-3-small

# --- 多供应商候选路由（可选，逗号分隔；用于 LLM 治理/降级） ---
# 格式: key1@url1|model1,key2@url2|model2
LLM_FALLBACKS=

# --- 可选: TTS / 外部数字人 API（可在 .env 里填；失败自动降级字幕） ---
TTS_API_KEY=
TTS_BASE_URL=
TTS_VOICE=zh-CN-XiaoxiaoNeural

# --- Cross-origin ---
CORS_ORIGINS=http://localhost:3000
