# ============================================================
# ResearchLens 环境配置示例
# 复制为 .env 后使用：  cp .env.example .env
#
# 两组用途：
#   · Docker 部署（推荐）：docker compose 读**仓库根目录**的 .env，
#     并把下面这些变量注入 backend / worker / frontend 容器；
#   · 本机直跑后端：后端读的是 **backend/.env**（core/config.py 里 load_dotenv
#     指向 backend/），此时 DATABASE_URL 才生效（默认 SQLite）。
# ============================================================

# --- ----------- 宿主端口（容器内固定 8000/3000）----------- ---
# 浏览器访问后端的地址：必须与 BACKEND_PORT 一致，且它是**构建期**写进
# 前端 bundle 的 —— 改完要 `docker compose build frontend` 才生效。
BACKEND_PORT=8002
NEXT_PUBLIC_API_URL=http://localhost:8002
# 前端界面端口：默认 4002（本机 3002 被 Windows 保留，故避开 300x）
FRONTEND_PORT=4002

# --- ----------- 数据库（Docker 部署由 compose 组装）----------- ---
# 注意：Docker 部署时 compose 会用自己的 DATABASE_URL 覆盖下面这行；
# 数据库端口**不对宿主发布**，只能从容器网络访问 db:5432。
POSTGRES_USER=researchlens
POSTGRES_PASSWORD=researchlens
POSTGRES_DB=researchlens
# 仅本机直跑后端时生效（Docker 部署忽略）：
DATABASE_URL=sqlite:///./data/researchlens.db

# --- ----------- AI（强烈建议配置）----------- ---
# 阿里云百炼 DashScope（OpenAI 兼容）：
#   控制台 https://bailian.console.aliyun.com/ → API-KEY 管理
# 留空 = 运行期降级为抽取式作答（这是降级，不是"演示模式"；界面不会冒充 AI 结论）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 视觉模型（图表/图片理解；DashScope 用 qwen-vl-max）
VISION_MODEL=qwen-vl-max
# 嵌入模型（向量检索；DashScope 兼容模式用 text-embedding-v3）
EMBEDDING_MODEL=text-embedding-v3

# --- 多供应商候选路由（可选，逗号分隔；主供应商失败自动切换）---
# 格式: key1@url1|model1,key2@url2|model2
LLM_FALLBACKS=

# --- ----------- 文档解析 MinerU（建议配置）----------- ---
# 凭证申请：https://mineru.net
# 留空 = 自动降级到内置 PyMuPDF 解析（仍能跑，但表格/图表/公式质量明显下降）
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
# 设为 0 可强制关闭 MinerU（即使配了 token）
MINERU_ENABLED=1

# --- ----------- 体积上限 ----------- ---
MAX_UPLOAD_MB=40
MAX_DOWNLOAD_MB=80

# --- ----------- 公开部署（可选）----------- ---
# PUBLIC_DEPLOYMENT=true 时必须同时配置 ADMIN_TOKEN，否则后端**启动即失败**
# （不会静默降级到无鉴权）
PUBLIC_DEPLOYMENT=false
ADMIN_TOKEN=

# --- 可选: TTS / 外部数字人 API（失败自动降级为字幕）---
TTS_API_KEY=
TTS_BASE_URL=
TTS_VOICE=zh-CN-XiaoxiaoNeural

# --- Cross-origin（要与 FRONTEND_PORT 一致）---
CORS_ORIGINS=http://localhost:4002,http://127.0.0.1:4002

# --- 前端数据源开关（构建期注入，改后需 --build 重建 frontend）---
# 0（默认）= 走真实 canonical API；1 = 静态 fixtures，仅离线开发用。
NEXT_PUBLIC_USE_FIXTURES=0
